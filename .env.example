# Gemini runs on Vertex AI (google-genai, ADR 0002). Credentials: Application Default Credentials, or for a
# local run whose ADC has no access to VERTEX_PROJECT, an access token: `gcloud auth print-access-token --account=...`
GENAI_BACKEND=vertex
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
# VERTEX_ACCESS_TOKEN=          # local only; lasts about an hour
# Revert path: GENAI_BACKEND=studio with a Google AI Studio key
# GEMINI_API_KEY=
# Parallel Search API key — https://platform.parallel.ai (partner integration; the crew's only research tool)
PARALLEL_API_KEY=
# Optional
GEMINI_MODEL=gemini-2.5-flash
PARALLEL_MODE=advanced          # turbo | fast | basic | advanced
MAX_TOOL_ROUNDS=2               # search rounds per specialist agent
PORT=8080
# Local UI development without spending Parallel credits (ignored when NODE_ENV=production)
# PARALLEL_MOCK=1
